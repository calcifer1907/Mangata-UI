{
        "rewrites": [
                {
                        "source": "/:path*",
                        "destination": "/index.html"
                }
        ],
        "builds": [
                {
                        "src": "package.json",
                        "use": "@vercel/static-build",
                        "config": {
                                "distDir": "dist"
                        }
                }
        ],
        "routes": [
                {
                        "src": "/(.*)",
                        "dest": "/index.html"
                }
        ],
        "headers": [
                {
                        "source": "/(.*)",
                        "headers": [
                                {
                                        "key": "Cache-Control",
                                        "value": "public, max-age=31536000, immutable"
                                },
                                {
                                        "key": "X-Frame-Options",
                                        "value": "DENY"
                                },
                                {
                                        "key": "X-Content-Type-Options",
                                        "value": "nosniff"
                                }
                        ]
                },
                {
                        "source": "assets/(.*)",
                        "headers": [
                                {
                                        "key": "Cache-Control",
                                        "value": "public, max-age=31536000, immutable"
                                }
                        ]
                }
        ]
}